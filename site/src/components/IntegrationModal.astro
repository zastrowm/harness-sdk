---
/**
 * The integration modal on a docs page under /docs/integrations/ (see
 * util/integration-modal.ts). PageFrame renders the page's main column inside
 * this dialog, with the site header and the catalog rail around it and an empty
 * backdrop region where the catalog grid goes.
 *
 * - Loaded directly: the script opens the dialog as modal and shows the whole
 *   catalog page behind it in an inert, full-window iframe
 *   (`/integrations/?embed=backdrop`), so the page looks like the catalog with
 *   the entry open over it. The catalog stays in its own
 *   document, so this page's DOM (what crawlers render) holds only the article.
 *   Closing returns to the catalog.
 * - In the catalog's iframe (`?embed`): embed mode hides the chrome and the dialog
 *   fills the frame; close and Esc are sent to the catalog page, which owns the
 *   history entry.
 *
 * Without JS the dialog renders open (non-modal) over an empty backdrop, and the
 * close button is a plain link to the catalog.
 */
import { pathWithBase } from '../util/links'
import '../styles/integration-modal.css'

const catalogHref = pathWithBase('/integrations/')
---

<dialog open class="integ-modal integ-modal--page" data-integ-modal data-catalog-href={catalogHref} aria-labelledby="_top">
  <div class="integ-modal-scroll" data-integ-scroll tabindex="-1" autofocus>
    <div class="integ-modal-bar">
      <a class="integ-modal-close" data-integ-close href={catalogHref} aria-label="Close" title="Close (Esc)">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M18.3 5.7a1 1 0 0 0-1.4 0L12 10.6 7.1 5.7a1 1 0 0 0-1.4 1.4l4.9 4.9-4.9 4.9a1 1 0 1 0 1.4 1.4l4.9-4.9 4.9 4.9a1 1 0 0 0 1.4-1.4L13.4 12l4.9-4.9a1 1 0 0 0 0-1.4z"></path>
        </svg>
      </a>
    </div>
    <slot />
  </div>
</dialog>

<style is:global>
  /* The dialog scrolls its content; the page behind it stays put. */
  html:has(.integ-modal[open]) {
    overflow: hidden;
  }

  .integ-modal--page {
    /* Starlight's layout offsets are for the page, not the dialog. */
    --sl-content-inline-start: 0rem;
    --sl-mobile-toc-height: 0rem;
    --sl-content-pad-x: 1.5rem;
    z-index: var(--sl-z-index-menu);
  }
  @media (max-width: 50rem) {
    .integ-modal--page {
      --sl-content-pad-x: 1rem;
    }
  }
  /* Without JS the dialog is open but not modal, so it has no ::backdrop. */
  .integ-modal--page:not(:modal) {
    box-shadow:
      0 24px 64px rgb(0 0 0 / 0.35),
      0 0 0 100vmax rgb(0 0 0 / 0.5);
  }

  .integ-modal-scroll {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    outline: none;
  }
  /* Starlight centres the text column only at 72rem and up, measured against the
     viewport. The catalog's iframe is narrower than a direct visit's viewport, so
     centre it in the dialog at every width to look the same both ways. */
  .integ-modal--page .sl-container {
    margin-inline: auto;
  }
  /* Wide tables and images size themselves against the viewport (custom.css);
     inside the dialog they keep to the text column. */
  :root[data-has-sidebar] .integ-modal .sl-markdown-content {
    --wide-grow: 0px;
  }

  /* Close button: pinned to the dialog's top-right corner while the content scrolls. */
  .integ-modal-bar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    justify-content: flex-end;
    height: 0;
  }
  .integ-modal-close {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin: 0.75rem 0.75rem 0 0;
    border-radius: 999px;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-2);
  }
  .integ-modal-close:hover,
  .integ-modal-close:focus-visible {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-3);
  }

  /* In the catalog's iframe the frame is the dialog box, so fill it. */
  html[data-embed=''] .integ-modal--page {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    animation: none;
  }
  html[data-embed=''] [data-integ-backdrop] {
    display: none;
  }

  /* The catalog page behind the dialog on a direct visit, over this page's own
     header and rail (which show without JS and on narrow screens). */
  .integ-modal-backdrop-frame {
    position: fixed;
    inset: 0;
    z-index: calc(var(--sl-z-index-navbar) + 1);
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
  }
</style>

<script>
  import {
    INTEGRATION_MODAL_CLOSE,
    INTEGRATION_MODAL_HASH,
    backdropQuery,
    docsCloseAction,
    fragmentId,
  } from '../util/integration-modal'

  const dialog = document.querySelector<HTMLDialogElement>('[data-integ-modal]')
  const closeLink = dialog?.querySelector<HTMLAnchorElement>('[data-integ-close]')
  const scroller = dialog?.querySelector<HTMLElement>('[data-integ-scroll]')
  const catalogPath = dialog?.dataset.catalogHref || '/integrations/'
  const embedded = document.documentElement.dataset.embed === '' && window.parent !== window

  // An inner dialog (image zoom) takes Esc first.
  const innerDialogOpen = () => !!document.querySelector('dialog[open]:not([data-integ-modal])')
  const targetOf = (hash: string) => {
    const id = fragmentId(hash)
    return id ? document.getElementById(id) : null
  }

  if (dialog && embedded) {
    // The catalog page owns the history entry and the outer dialog; ask it to close.
    const post = (message: object) => window.parent.postMessage(message, location.origin)
    closeLink?.addEventListener('click', (e) => {
      e.preventDefault()
      post({ type: INTEGRATION_MODAL_CLOSE })
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !e.defaultPrevented && !innerDialogOpen()) post({ type: INTEGRATION_MODAL_CLOSE })
    })
    // Same-page anchors: scroll without a fragment navigation, which would add an
    // entry to the tab's history from inside the iframe. The catalog page puts
    // the #fragment on its own URL instead.
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return
      const link = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="#"]')
      const target = link ? targetOf(link.hash) : null
      if (!link || !target) return
      e.preventDefault()
      target.scrollIntoView()
      history.replaceState(history.state, '', link.hash)
      post({ type: INTEGRATION_MODAL_HASH, hash: link.hash })
    })
    scroller?.focus({ preventScroll: true })
  } else if (dialog) {
    const ctx = { state: history.state, referrer: document.referrer, origin: location.origin, catalogPath }

    const close = () => {
      const action = docsCloseAction(ctx)
      if (action.kind === 'back') history.back()
      else if (action.kind === 'replace') location.replace(action.url)
      else location.assign(action.url)
    }

    // Esc: handled on keydown, because without a prior user gesture Chrome closes
    // the dialog without a cancelable `cancel` event. `cancel` still covers other
    // close requests (Android's back gesture).
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || e.defaultPrevented || innerDialogOpen()) return
      e.preventDefault()
      close()
    })
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault()
      close()
    })
    closeLink?.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return
      e.preventDefault()
      close()
    })
    // A click on the dimmed area lands on the dialog element itself.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close()
    })

    // After a reload of a URL the catalog pushed, Chrome can step Back to the
    // catalog's entry within this document (a popstate, no page load). Load it.
    const ownPath = location.pathname
    window.addEventListener('popstate', () => {
      if (location.pathname !== ownPath) location.reload()
    })

    // Reopen as modal: the page behind goes inert, focus stays in the dialog.
    const scrollTop = scroller?.scrollTop ?? 0
    dialog.close()
    dialog.showModal()
    const target = targetOf(location.hash)
    if (target) target.scrollIntoView()
    else if (scroller) scroller.scrollTop = scrollTop
    scroller?.focus({ preventScroll: true })

    // Show the catalog behind the dialog, with the search the user came from when
    // known. Skipped on narrow screens, where the dialog covers the viewport.
    const backdrop = document.querySelector<HTMLElement>('[data-integ-backdrop]')
    if (backdrop && matchMedia('(min-width: 50rem)').matches) {
      const query = new URLSearchParams(backdropQuery(ctx))
      query.set('embed', 'backdrop')
      const frame = document.createElement('iframe')
      frame.className = 'integ-modal-backdrop-frame'
      frame.src = `${catalogPath}?${query}`
      frame.tabIndex = -1
      // No scrollbar inside: the window behind a modal doesn't scroll either.
      frame.setAttribute('scrolling', 'no')
      frame.title = ''
      frame.setAttribute('aria-hidden', 'true')
      backdrop.append(frame)
    }
  }
</script>
